// Based on #1576
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/labubu.txt"
    },

    "display": {
        "color": {
            "keys": "blue"
        },
        "separator": "",
        "constants": [
            "──────────────────────────────────────────────",
            "\u001b[47D",
            "\u001b[47C",
            "\u001b[46C"
        ],
        "brightColor": false
    },
    "modules": [
        {
            "type": "version",
            "key": "┌───────────────┬─{$1}┐\u001b[41D",
            "format": "\u001b[1m{#keys} {1} - {2} "
        },
        {
            "type": "os",
            "keyIcon": "",
            "key": "│  {icon}  \u001b[s{sysname}\u001b[u\u001b[10C│{$3}|{$2}"
        },

        // Hardware
        {
            "type": "custom",
            "key": "│{#cyan}┌──────────────┬{$1}┐{#keys}│\u001b[37D",
            "format": "{#bright_cyan} Hardware "
        },
        {
            "type": "memory",
            "key": "│{#cyan}│ {icon}  RAM       │{$4}│{#keys}│{$2}"
        },
        {
            "type": "swap",
            "key": "│{#cyan}│ {icon}  SWAP      │{$4}│{#keys}│{$2}"
        },
        {
            "type": "cpu",
            "key": "│{#cyan}│ {icon}  CPU       │{$4}│{#keys}│{$2}",
            "showPeCoreCount": true
        },
        {
            "type": "custom",
            "key": "│{#cyan}└──────────────┴{$1}┘{#keys}│",
            "format": ""
        },
        // Terminal
        {
            "type": "custom",
            "key": "│{#yellow}┌──────────────┬{$1}┐{#keys}│\u001b[37D",
            "format": "{#bright_yellow} Terminal "
        },
        {
            "type": "shell",
            "key": "│{#yellow}│ {#white}{icon}  {#yellow}Shell     │{$4}│{#keys}│{$2}"
        },
        {
            "type": "terminal",
            "keyIcon": "󰊠",
            "key": "│{#yellow}│ {#blue}{icon} {#yellow} Terminal  │{$4}│{#keys}│{$2}"
        },
        {
            "type": "packages",
            "keyIcon": "󰟟",
            "key": "│{#yellow}│ {#red}{icon}  {#yellow}Packages  │{$4}│{#keys}│{$2}"
        },
        {
            "type": "custom",
            "key": "│{#yellow}└──────────────┴{$1}┘{#keys}│",
            "format": ""
        },

        // Development
        {
            "type": "custom",
            "key": "│{#red}┌──────────────┬{$1}┐{#keys}│\u001b[39D",
            "format": "{#bright_red} Development "
        },
        {
            "type": "command",
            "keyIcon": "",
            "key": "│{#red}│ {icon}  Rust      │{$4}│{#keys}│{$2}",
            "text": "rustc --version | cut -d' ' -f2",
            "format": "rustc {}"
        },
        {
            "type": "command",
            "keyIcon": "",
            "key": "│{#red}│{#blue} {icon}  {#red}Clang     │{$4}│{#keys}│{$2}",
            "text": "clang --version | head -1 | awk '{print $NF}'",
            "format": "Clang {}"
        },
        {
            "type": "command",
            "keyIcon": "",
            "key": "│{#red}│ {#yellow}{icon}  {#red}Python    │{$4}│{#keys}│{$2}",
            "text": "python --version",
            "format": "{}"
        },
        {
            "type": "command",
            "keyIcon": "",
            "key": "│{#red}│ {icon}  Go        │{$4}│{#keys}│{$2}",
            "text": "go version | cut -d' ' -f3",
            "format": "go {~2}"
        },
        {
            "type": "command",
            "keyIcon": "",
            "key": "│{#red}│ {#dim_yellow}{icon} {#reset_red} Zig       │{$4}│{#keys}│{$2}",
            "text": "zig version",
            "format": "Zig {}"
        },
        {
            "type": "command",
            "keyIcon": "",
            "key": "│{#red}│ {#green}{icon} {#red} Editor    │{$4}│{#keys}│{$2}",
            "text": "nvim -v | head -n1 | cut -c5-12",
            "format": "NeoVim{}"
        },
        {
            "type": "command",
            "keyIcon": "󰊢",
            "key": "│{#red}│ {#white}{icon} {#red} Git       │{$4}│{#keys}│{$2}",
            "text": "git version",
            "format": "Git {~12}"
        },
        {
            "type": "custom",
            "key": "│{#red}└──────────────┴{$1}┘{#keys}│",
            "format": ""
        },

        {
            "type": "custom",
            "key": "└─────────────────{$1}┘",
            "format": ""
        },

        // End
        "break",
    ]
}
